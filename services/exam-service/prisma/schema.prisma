// Xe-Recruiters — Exam Service Prisma Schema
// Owns: exams, sections, exam_assignments, exam_candidates

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/exam"
}

datasource db {
  provider = "mongodb"
  url      = env("EXAM_DATABASE_URL")
}

model Exam {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String         @map("tenant_id")
  title             String
  description       String?
  instructions      String?
  status            ExamStatus     @default(DRAFT)
  duration          Int            // in minutes
  totalMarks        Int            @map("total_marks")
  passingScore      Int            @map("passing_score")
  startTime         DateTime?      @map("start_time")
  endTime           DateTime?      @map("end_time")
  navigationRule    NavigationRule @default(FREE) @map("navigation_rule")
  shuffleQuestions  Boolean        @default(false) @map("shuffle_questions")
  shuffleOptions    Boolean        @default(false) @map("shuffle_options")
  showResults       Boolean        @default(true) @map("show_results")
  enableProctoring  Boolean        @default(true) @map("enable_proctoring")
  proctoringMode    String         @default("AI_ONLY") @map("proctoring_mode")
  proctoringFlags   String[]       @map("proctoring_flags")
  recordingConfig   String         @default("WEBCAM_ONLY") @map("recording_config")
  sensitivityNotifyLimit     Int   @default(70) @map("sensitivity_notify_limit")
  sensitivityWarningLimit    Int   @default(50) @map("sensitivity_warning_limit")
  sensitivityTerminationLimit Int  @default(30) @map("sensitivity_termination_limit")
  autoTerminateOnTrustLimit  Boolean @default(true) @map("auto_terminate_on_trust_limit")
  proctoringSettingsLocked   Boolean @default(false) @map("proctoring_settings_locked")
  maxAttempts       Int            @default(1) @map("max_attempts")
  negativeMarking   Boolean        @default(false) @map("negative_marking")
  negativeMarkValue Float          @default(0.0) @map("negative_mark_value")
  certificateIssuance Boolean      @default(false) @map("certificate_issuance")
  createdBy         String         @map("created_by")
  publishedAt       DateTime?      @map("published_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sections    ExamSection[]
  assignments ExamAssignment[]

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@map("exams")
}

model ExamSection {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  examId      String  @map("exam_id") @db.ObjectId
  title       String
  description String?
  order       Int
  timeLimit   Int?    @map("time_limit") // optional per-section time limit in minutes

  exam      Exam                @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions ExamSectionQuestion[]

  @@index([examId])
  @@map("exam_sections")
}

model ExamSectionQuestion {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  sectionId  String @map("section_id") @db.ObjectId
  questionId String @map("question_id")
  order      Int
  points     Int?   // override question default points

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sectionId, questionId])
  @@index([sectionId])
  @@map("exam_section_questions")
}

model ExamAssignment {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  examId      String               @map("exam_id") @db.ObjectId
  tenantId    String               @map("tenant_id")
  candidateId String               @map("candidate_id")
  status      AssignmentStatus     @default(ASSIGNED)
  sessionStatus String             @default("ACTIVE") @map("session_status") // ACTIVE, DISCONNECTED, WARNED, FLAGGED, TERMINATED, SUBMITTED
  assignedAt  DateTime             @default(now()) @map("assigned_at")
  startedAt   DateTime?            @map("started_at")
  submittedAt DateTime?            @map("submitted_at")
  score       Float?
  totalMarks      Int?                 @map("total_marks")
  answers         String?
  attemptsUsed    Int                  @default(0) @map("attempts_used")
  timeMultiplier  Float                @default(1.0) @map("time_multiplier")
  extraTimeMinutes Int                  @default(0) @map("extra_time_minutes")
  trustScore      Int                  @default(100) @map("trust_score")
  onboardingLogs  String?              @map("onboarding_logs")
  terminationReason String?            @map("termination_reason")
  terminationNote   String?            @map("termination_note")
  proctorWarnings   String?            @map("proctor_warnings") // JSON string array of warning logs
  incidents       Incident[]
  decisionLogs    ProctorDecisionLog[]
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([examId, candidateId])
  @@index([examId])
  @@index([candidateId])
  @@index([tenantId])
  @@map("exam_assignments")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum NavigationRule {
  FREE
  LINEAR
  SECTION_LOCKED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

model Certificate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String   @map("tenant_id")
  assignmentId  String   @unique @map("assignment_id") @db.ObjectId
  candidateId   String   @map("candidate_id")
  candidateName String   @map("candidate_name")
  examId        String   @map("exam_id") @db.ObjectId
  examTitle     String   @map("exam_title")
  score         Float
  totalMarks    Int      @map("total_marks")
  issuedAt      DateTime @default(now()) @map("issued_at")
  issuingOrg    String   @map("issuing_org")
  signature     String

  @@index([tenantId])
  @@index([candidateId])
  @@index([examId])
  @@map("certificates")
}

model Incident {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId     String         @map("assignment_id") @db.ObjectId
  timestamp        DateTime       @default(now()) @map("timestamp")
  flagType         String         @map("flag_type")
  severity         String         @map("severity") // LOW, MEDIUM, HIGH
  confidenceScore  Float          @map("confidence_score")
  screenshot       String?        @map("screenshot") // Base64 or URL
  reviewerDecision String         @default("PENDING") @map("reviewer_decision") // PENDING, DISMISSED, WARNED, ESCALATED, TERMINATED
  reviewerReason   String?        @map("reviewer_reason")
  reviewerIdentity String?        @map("reviewer_identity")
  decidedAt        DateTime?      @map("decided_at")

  assignment       ExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignmentId])
  @@map("exam_incidents")
}

model ProctorDecisionLog {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId     String         @map("assignment_id") @db.ObjectId
  incidentId       String?        @map("incident_id")
  actionType       String         @map("action_type") // WARN, TERMINATE, DISMISS_FLAG, ESCALATE, OVERRIDE_SCORE
  rationale        String         @map("rationale")
  reviewerIdentity String         @map("reviewer_identity")
  timestamp        DateTime       @default(now()) @map("timestamp")

  assignment       ExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignmentId])
  @@map("proctor_decision_logs")
}


