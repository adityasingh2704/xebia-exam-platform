# ============================================
# Xe-Recruiters — Environment Variables
# ============================================

# ── Node Environment ──
NODE_ENV=development

# ── Database (MongoDB Atlas) ──
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
AUTH_DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/xe_auth?retryWrites=true&w=majority"
TENANT_DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/xe_tenant?retryWrites=true&w=majority"
USER_DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/xe_user?retryWrites=true&w=majority"
EXAM_DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/xe_exam?retryWrites=true&w=majority"
QUESTION_DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/xe_question?retryWrites=true&w=majority"

# Old PostgreSQL URLs (Commented out)
# AUTH_DATABASE_URL=postgresql://xe_admin:xe_secret_2024@localhost:5432/xe_auth
# TENANT_DATABASE_URL=postgresql://xe_admin:xe_secret_2024@localhost:5432/xe_tenant
# USER_DATABASE_URL=postgresql://xe_admin:xe_secret_2024@localhost:5432/xe_user
# EXAM_DATABASE_URL=postgresql://xe_admin:xe_secret_2024@localhost:5432/xe_exam
# QUESTION_DATABASE_URL=postgresql://xe_admin:xe_secret_2024@localhost:5432/xe_question

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=xe_redis_2024

# ── Kafka ──
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=xe-recruiters

# ── MinIO (S3) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=xe_minio_access
MINIO_SECRET_KEY=xe_minio_secret_2024
MINIO_BUCKET=xe-recruiters

# ── JWT ──
JWT_SECRET=xe-recruiters-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=xe-recruiters-refresh-secret-change-in-production-2024
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Service Ports ──
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
EXAM_SERVICE_PORT=3004
QUESTION_SERVICE_PORT=3005

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Xe-Recruiters

# ── Email (SMTP) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@xe-recruiters.com

# ── Judge0 (Code Execution Engine) ──
JUDGE0_API_URL=http://localhost:2358
JUDGE0_AUTHN_TOKEN=xe-judge0-secret-2024
JUDGE0_AUTHZ_TOKEN=xe-judge0-admin-2024
